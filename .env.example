# /!\ Store secrets (GITHUB_READ_TOKEN, BRAVE_API_KEY, etc.) in `~/.config/agwo/env` inside the OS that run your tools.

# Self-hosted models (LM Studio)
LMSTUDIO_MODEL=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_CONTEXT=8192
LMSTUDIO_FUNCTION_CALLING=true
AGENTS_FLOW_WSL_DISTRO=Ubuntu
AGENTS_FLOW_WSL_EXE=wsl.exe

# Cloud model (fallback if deployment.jsonc has no LLM profile)
# CrewAI "provider/model" format. Adjust to a model available on your account.
# AGENTS_FLOW_MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# Alternatively : AGENTS_FLOW_MODEL=openai/gpt-4o-mini + OPENAI_API_KEY=

# Workspace and audit 
AGENTS_FLOW_WORKSPACE=./workspace
AGENTS_FLOW_AUDIT_LOG=./audit/audit.jsonl
# AGENTS_FLOW_CONFIG_DIR=./config

# GitHub (read-only). Fine-grained token: Contents / Issues / Pull requests = Read-only.
GITHUB_READ_TOKEN=

# Web search (only if network.search_provider != "none")
# BRAVE_API_KEY=