// =============================================================================
// deployment.jsonc — OÙ tourne quoi. (Hors empreinte de politique : voir remote/config_hash.py.)
//
//   Windows 11 ARM64 : Python/uv + CrewAI + la boucle des agents + LM Studio (natif Windows)
//   WSL (Linux)      : TOUS les outils (fichiers, Git, shell, web, documents), l'exécuteur, SearXNG
//
// Les outils s'exécutent dans WSL parce que les garde-fous valident chemins, liens symboliques, inodes et
// état Git SUR LE SYSTÈME DE FICHIERS QU'ILS PROTÈGENT. Depuis Windows (chemins UNC \\wsl$), ces garanties
// ne tiendraient pas ; et un simple préfixe `wsl --` devant une chaîne de commande la ferait réinterpréter
// par le shell Linux. Voir docs/WINDOWS-WSL.md.
// =============================================================================
{
    "version": 1,
    // "wsl"   : CrewAI sous Windows, outils dans WSL (déploiement cible)
    // "local" : tout dans CE processus (à utiliser DANS WSL/Linux, pour le développement et les tests)
    "backend": "wsl",
    "wsl": {
        "exe": "${AGENTS_FLOW_WSL_EXE:-wsl.exe}",
        // Nom exact : `wsl -l -q`. Une distribution DÉDIÉE aux agents est recommandée (docs/WINDOWS-WSL.md).
        "distro": "${AGENTS_FLOW_WSL_DISTRO:-Ubuntu-24.04}",
        "user": null, // utilisateur Linux non-root ; null = utilisateur par défaut de la distribution
        // Préfixe automatique de TOUTE commande lancée dans WSL :
        //   auto            -> `wsl.exe -d <distro> --cd ~ --shell-type none -- …`, sinon `--exec` (WSL ancien)
        //   shell-type-none -> force `--shell-type none --`
        //   exec            -> force `--exec`
        // Jamais de `wsl --` seul : il passerait par le shell Linux par défaut.
        "launch": "auto",
        "install_dir": "~/agwo", // côté WSL : paquet, .venv et copie de la politique
        "env_file": "~/.config/agwo/env", // côté WSL, mode 600 : GITHUB_READ_TOKEN, BRAVE_API_KEY…
        "startup_timeout_s": 90,
        "call_timeout_s": 180,
        "max_message_bytes": 8000000
    },
    // Miroir de l'audit côté Windows (la référence est écrite dans WSL).
    "client_audit_path": "${AGENTS_FLOW_CLIENT_AUDIT_LOG:-./audit/client-audit.jsonl}",
    // ----------------------------------------------------------------- LLM (LM Studio, natif Windows)
    // CrewAI tourne sous Windows, donc LM Studio est joint en loopback : aucune ouverture réseau vers WSL.
    "llm": {
        "default": "lmstudio",
        "profiles": {
            "lmstudio": {
                // Identifiant EXACT affiché par LM Studio (GET http://127.0.0.1:1234/v1/models, ou `agwo llm check`).
                "model": "${LMSTUDIO_MODEL}",
                "base_url": "${LMSTUDIO_BASE_URL:-http://127.0.0.1:1234/v1}",
                "api_key": "lm-studio",
                "temperature": 0.2,
                "timeout_s": 300,
                // Contexte RÉELLEMENT chargé dans LM Studio (Model settings → Context Length).
                "context_window": "${LMSTUDIO_CONTEXT:-8192}",
                // true  : appels d'outils natifs OpenAI (modèles entraînés au tool use : Qwen3/2.5, Llama 3.1+, gpt-oss…)
                // false : format ReAct texte, accepté par tout modèle mais moins fiable
                "function_calling": "${LMSTUDIO_FUNCTION_CALLING:-false}"
            }
        }
    }
}