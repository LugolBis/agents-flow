// =============================================================================
// deployment.jsonc — WHERE things run. (Outside policy footprint: see remote/config_hash.py.)
//
//   Windows 11 ARM64 : Python/uv + CrewAI + agent loop + LM Studio (Windows native)
//   WSL (Linux)      : ALL tools (files, Git, shell, web, docs), runner, SearXNG
//
// Tools execute in WSL because guardrails validate paths, symlinks, inodes, and
// Git status ON THE FILE SYSTEM THEY PROTECT. From Windows (UNC paths \\wsl$), these guarantees
// would not hold; and a simple `wsl --` prefix in front of a command string would cause reinterpretation
// by the Linux shell. See docs/WINDOWS-WSL.md.
// =============================================================================
{
    "version": 1,
    // "wsl"   : CrewAI under Windows, tools inside WSL (target deployment)
    // "local" : everything in THIS process (for development and tests INSIDE WSL/Linux)
    "backend": "wsl",
    "wsl": {
        "exe": "${AGENTS_FLOW_WSL_EXE:-wsl.exe}",
        // Exact name: `wsl -l -q`. A DEDICATED distribution for agents is recommended (docs/WINDOWS-WSL.md).
        "distro": "${AGENTS_FLOW_WSL_DISTRO:-Ubuntu-24.04}",
        "user": null, // non-root Linux user; null = distribution default user
        // Automatic prefix for EVERY command executed inside WSL:
        //   auto            -> `wsl.exe -d <distro> --cd ~ --shell-type none -- …`, otherwise `--exec` (legacy WSL)
        //   shell-type-none -> force `--shell-type none --`
        //   exec            -> force `--exec`
        // Never standalone `wsl --`: it would pass through default Linux shell.
        "launch": "auto",
        "install_dir": "~/agwo", // WSL side: package, .venv, and policy copy
        "env_file": "~/.config/agwo/env", // WSL side, mode 600: GITHUB_READ_TOKEN, BRAVE_API_KEY…
        "startup_timeout_s": 90,
        "call_timeout_s": 180,
        "max_message_bytes": 8000000
    },
    // Mirror audit log on Windows side (reference log is written in WSL).
    "client_audit_path": "${AGENTS_FLOW_CLIENT_AUDIT_LOG:-./audit/client-audit.jsonl}",
    // CrewAI runs under Windows, so LM Studio is connected over loopback: no open network to WSL required.
    "llm": {
        "default": "lmstudio",
        "profiles": {
            "lmstudio": {
                // EXACT ID displayed in LM Studio (GET http://127.0.0.1:1234/v1/models, or `agwo llm check`).
                "model": "${LMSTUDIO_MODEL}",
                "base_url": "${LMSTUDIO_BASE_URL:-http://127.0.0.1:1234/v1}",
                "api_key": "${LMSTUDIO_API_KEY:-your-api-key-generated-on-lm-studio}",
                "temperature": 0.2,
                "timeout_s": 300,
                // Context length ACTUALLY loaded in LM Studio (Model settings → Context Length).
                "context_window": "${LMSTUDIO_CONTEXT:-8192}",
                // true  : native OpenAI tool calls (models trained for tool use: Qwen3/2.5, Llama 3.1+, gpt-oss…)
                // false : ReAct text format, supported by all models but less reliable
                "function_calling": "${LMSTUDIO_FUNCTION_CALLING:-false}",
                // "auto" | "json_schema" | "off" — response_format for agents that define output_schema
                "structured_output": "auto"
            }
        }
    }
}