// =============================================================================
// tools.jsonc — DECLARATIVE tools registry.
//
// "class"        : Python class (restricted loading under prefix agents_flow.tools.)
// "capabilities" : required capabilities. MUST match class declaration
//                  `required_capabilities` (verified at startup: divergence is an
//                  error, never a silent privilege escalation).
// "enabled"      : false = tool never instantiated, even if granted.
//
// Config describes; Python code (tools + security/*) enforces.
// =============================================================================
{
    "version": 1,
    "tools": {
        // ---- File system
        "read_file": {
            "class": "agents_flow.tools.fs.ReadFileTool",
            "capabilities": [
                "fs.read"
            ]
        },
        "list_dir": {
            "class": "agents_flow.tools.fs.ListDirTool",
            "capabilities": [
                "fs.read"
            ]
        },
        "search_in_files": {
            "class": "agents_flow.tools.fs.SearchInFilesTool",
            "capabilities": [
                "fs.read"
            ]
        },
        "create_file": {
            "class": "agents_flow.tools.fs.CreateFileTool",
            "capabilities": [
                "fs.write"
            ]
        },
        "modify_file": {
            "class": "agents_flow.tools.fs.ModifyFileTool",
            "capabilities": [
                "fs.read",
                "fs.write"
            ]
        },
        "check_file_modifiable": {
            "class": "agents_flow.tools.fs.CheckFileModifiableTool",
            "capabilities": [
                "fs.read"
            ]
        },
        // ---- Local Git: READ
        "git_info": {
            "class": "agents_flow.tools.git_tools.GitInfoTool",
            "capabilities": [
                "git.read"
            ]
        },
        "git_status": {
            "class": "agents_flow.tools.git_tools.GitStatusTool",
            "capabilities": [
                "git.read"
            ]
        },
        "git_log": {
            "class": "agents_flow.tools.git_tools.GitLogTool",
            "capabilities": [
                "git.read"
            ]
        },
        "git_diff": {
            "class": "agents_flow.tools.git_tools.GitDiffTool",
            "capabilities": [
                "git.read"
            ]
        },
        "git_show": {
            "class": "agents_flow.tools.git_tools.GitShowTool",
            "capabilities": [
                "git.read"
            ]
        },
        "git_show_file": {
            "class": "agents_flow.tools.git_tools.GitShowFileTool",
            "capabilities": [
                "git.read"
            ]
        },
        "git_ls_files": {
            "class": "agents_flow.tools.git_tools.GitLsFilesTool",
            "capabilities": [
                "git.read"
            ]
        },
        "git_branches": {
            "class": "agents_flow.tools.git_tools.GitBranchesTool",
            "capabilities": [
                "git.read"
            ]
        },
        // ---- Local Git: WRITE (exactly 3 operations)
        "git_create_branch": {
            "class": "agents_flow.tools.git_tools.GitCreateBranchTool",
            "capabilities": [
                "git.write_local"
            ]
        },
        "git_switch_branch": {
            "class": "agents_flow.tools.git_tools.GitSwitchBranchTool",
            "capabilities": [
                "git.write_local"
            ]
        },
        "git_commit": {
            "class": "agents_flow.tools.git_tools.GitCommitTool",
            "capabilities": [
                "git.write_local"
            ]
        },
        // ---- Remote GitHub: READ ONLY (GET only, api.github.com host)
        "github_get_repo": {
            "class": "agents_flow.tools.github.GitHubGetRepoTool",
            "capabilities": [
                "github.read"
            ]
        },
        "github_list_tree": {
            "class": "agents_flow.tools.github.GitHubListTreeTool",
            "capabilities": [
                "github.read"
            ]
        },
        "github_get_file": {
            "class": "agents_flow.tools.github.GitHubGetFileTool",
            "capabilities": [
                "github.read"
            ]
        },
        "github_list_commits": {
            "class": "agents_flow.tools.github.GitHubListCommitsTool",
            "capabilities": [
                "github.read"
            ]
        },
        "github_list_issues": {
            "class": "agents_flow.tools.github.GitHubListIssuesTool",
            "capabilities": [
                "github.read"
            ]
        },
        "github_list_pulls": {
            "class": "agents_flow.tools.github.GitHubListPullsTool",
            "capabilities": [
                "github.read"
            ]
        },
        // ---- Shell: allowlist inspection (never arbitrary shell execution)
        "shell_inspect": {
            "class": "agents_flow.tools.shell.ShellInspectTool",
            "capabilities": [
                "shell.inspect"
            ]
        },
        // ---- Web
        "web_search": {
            "class": "agents_flow.tools.web.WebSearchTool",
            "capabilities": [
                "net.read"
            ]
        },
        "fetch_page": {
            "class": "agents_flow.tools.web.FetchPageTool",
            "capabilities": [
                "net.read"
            ]
        },
        "extract_links": {
            "class": "agents_flow.tools.web.ExtractLinksTool",
            "capabilities": [
                "net.read"
            ]
        },
        "crawl_site": {
            "class": "agents_flow.tools.web.CrawlSiteTool",
            "capabilities": [
                "net.read"
            ]
        },
        // Requires `pip install .[browser]` + `playwright install chromium`. Untested here.
        "browser_fetch": {
            "class": "agents_flow.tools.web.BrowserFetchTool",
            "capabilities": [
                "net.read"
            ],
            "enabled": false
        },
        // ---- Documents
        "read_document": {
            "class": "agents_flow.tools.documents.ReadDocumentTool",
            "capabilities": [
                "fs.read"
            ]
        },
        "search_in_document": {
            "class": "agents_flow.tools.documents.SearchInDocumentTool",
            "capabilities": [
                "fs.read"
            ]
        },
        "compare_documents": {
            "class": "agents_flow.tools.documents.CompareDocumentsTool",
            "capabilities": [
                "fs.read"
            ]
        },
        // ---- Project (static analysis, no execution of project code)
        "scan_project": {
            "class": "agents_flow.tools.project.ScanProjectTool",
            "capabilities": [
                "fs.read"
            ]
        },
        "python_import_graph": {
            "class": "agents_flow.tools.project.PythonImportGraphTool",
            "capabilities": [
                "fs.read"
            ]
        },
        // ---- Test execution: DISABLED by default (executes project code)
        "run_tests": {
            "class": "agents_flow.tools.tests_runner.RunTestsTool",
            "capabilities": [
                "exec.tests"
            ],
            "enabled": false
        }
    }
}